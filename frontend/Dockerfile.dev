# Development-only image. Dependency installation is guarded by the lockfile hash
# at container start so the named node_modules volume stays consistent with npm ci.
FROM node:20-alpine

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace

COPY docker-entrypoint.dev.sh /usr/local/bin/urbancoolsim-frontend-dev
RUN chmod +x /usr/local/bin/urbancoolsim-frontend-dev

EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/urbancoolsim-frontend-dev"]
