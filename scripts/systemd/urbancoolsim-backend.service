[Unit]
Description=UrbanCoolSim FastAPI Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/urbancoolsim
EnvironmentFile=/opt/urbancoolsim/.env
ExecStart=/opt/urbancoolsim/.venv-backend/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/var/log/urbancoolsim/backend.log
StandardError=append:/var/log/urbancoolsim/backend_error.log

[Install]
WantedBy=multi-user.target

